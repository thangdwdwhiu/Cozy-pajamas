# Copy to .env; never commit real credentials.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://cozy:CHANGE_ME@localhost:5432/cozy_pajamas
AUTO_MIGRATE=true
# Supabase: DATABASE_URL = Direct URI port 5432. Startup creates tables automatically.
# Optional migration URI; MUST target the same database as DATABASE_URL.
DIRECT_DATABASE_URL=
# local on Windows/VPS; supabase REQUIRED on Vercel
MEDIA_STORAGE=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
AUTH_SECRET=
ADMIN_EMAIL=admin@cozypajamas.local
ADMIN_PASSWORD=
CRON_SECRET=
PAYMENT_PROVIDER=sepay
PAYMENT_CURRENCY=VND
PAYMENT_LIVE_ENABLED=false
BANK_CODE=ICB
BANK_BIN=970415
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
SEPAY_API_TOKEN=
SEPAY_TRANSFER_PREFIX=SEVQR
SEPAY_WEBHOOK_AUTH=HMAC_SHA256
SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_PATH=/api/webhooks/sepay
