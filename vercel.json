{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci --cache /tmp/npm-cache",
  "functions": { "src/app/api/**/route.ts": { "maxDuration": 60 } },
  "crons": [{ "path": "/api/cron/expire", "schedule": "* * * * *" }]
}
