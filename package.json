{
  "name": "cozy-pajamas",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "next build",
    "start": "node scripts/run.mjs start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:setup": "tsx scripts/setup.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "worker": "node --env-file=.env scripts/worker.mjs",
    "payment:simulate": "tsx scripts/simulate-payment.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "test:admin": "node scripts/admin-browser-check.mjs",
    "payment:check": "node scripts/payment-check.mjs",
    "format": "prettier --write src scripts tests docs *.ts *.json *.md"
  },
  "dependencies": {
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
